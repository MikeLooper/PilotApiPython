APP_NAME=PilotApiPython
APP_VERSION=1.1.2
# Normally supplied by the build/deploy pipeline. When unset, /about reports
# APP_VERSION as the build version and the process start time as the deploy date.
# APP_BUILD_VERSION=1.1.2+build.1
# APP_DEPLOY_DATE=2026-01-01T00:00:00+00:00
APP_SUMMARY=Proof of concept API for the Northwind database.
APP_CONTACT_NAME=Michael Looper
APP_CONTACT_EMAIL=MikelLooper@gmail.com
APP_CONTACT_URL=https://github.com/MikeLooper
APP_LICENSE_NAME=MIT
APP_LICENSE_URL=https://opensource.org
LOG_LEVEL=INFO
LOG_JSON=true
DB_NAME=NorthWind
DB_CONNECT_TIMEOUT=30
DB_HOST=localhost
# Required unless DATABASE_URL is set; the application will not start without one of them.
DB_PASSWORD=<DevUser password>
DB_PORT=1433
DB_SCHEMA=dbo
DB_USER=DevUser
DB_DRIVER=ODBC Driver 18 for SQL Server
# Defaults to false. true is only for the local Docker SQL Server's self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=true
# Optional full override:
# DATABASE_URL=mssql+pyodbc://DevUser:<DevUser%20password>@localhost:1433/NorthWind?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&timeout=30

SECURITY_ACTIVE=true
IDENTITY_PROVIDER_BASE_URL=http://localhost:11141
# Externally-visible base URL clients use to obtain tokens. Only needed when this API
# reaches the identity provider a different way than clients do (e.g. via a Docker-internal
# hostname in production); otherwise it falls back to IDENTITY_PROVIDER_BASE_URL above.
# IDENTITY_PROVIDER_PUBLIC_BASE_URL=http://localhost:11141
IDENTITY_PROVIDER_REALM=local-realm
IDENTITY_PROVIDER_CLIENT_ID=local-client
IDENTITY_PROVIDER_AUDIENCE=

OTEL_ENABLED=true
OTEL_SERVICE_NAME=pilot-api-python
# "grpc" (port 4317, default) or "http" (port 4318).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENVIRONMENT=local-dev
